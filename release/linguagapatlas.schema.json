        "inference_paradigm": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            "Discriminative",
            "Generative",
            "Retrieval-Augmented",
            "Mixed",
            "Other",
            "confidence",
            null
          ]
        },
        "provenance_url": {
          "type": [
            "string",
            "null"
          ]
        },
        "evidence_note": {
          "type": [
            "string",
            "null"
          ]
        },
        "confidence": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            "high",
            "medium",
            "low",
            null
          ]
        },
        "screening_reason": {
          "type": [
            "string",
            "null"
          ]
        },
        "labels_as_written": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "data_origin",
            "resource_tier",
            "task_class",
            "cultural_specificity",
            "inference_paradigm"
          ],
          "properties": {
            "type": {
              "type": [
                "string",
                "null"
              ]
            },
            "data_origin": {
              "type": [
                "string",
                "null"
              ]
            },
            "resource_tier": {
              "type": [
                "string",
                "null"
              ]
            },
            "task_class": {
              "type": [
                "string",
                "null"
              ]
            },
            "cultural_specificity": {
              "type": [
                "string",
                "null"
              ]
            },
            "inference_paradigm": {
              "type": [
                "string",
                "null"
              ]
            }
          },
          "description": "The round's label strings exactly as written in its file."
        }
      }
    },
    "decision_type": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "value",
        "status",
        "support",
        "rounds_coded",
        "split",
        "votes"
      ],
      "properties": {
        "value": {
          "enum": [
            "Benchmark",
            "Dataset",
            null
          ]
        },
        "status": {
          "enum": [
            "consensus",
            "no_majority",
            "not_coded"
          ]
        },
        "support": {
          "type": "integer",
          "minimum": 0,
          "maximum": 5
        },
        "rounds_coded": {
          "type": "integer",
          "minimum": 0,
          "maximum": 5
        },
        "split": {
          "type": "boolean"
        },
        "votes": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "value",
              "count",
              "rounds"
            ],
            "properties": {
              "value": {
                "enum": [
                  "Benchmark",
                  "Dataset"
                ]
              },
              "count": {
                "type": "integer",
                "minimum": 1
              },
              "rounds": {
                "type": "array",
                "uniqueItems": true,
                "items": {
                  "enum": [
                    "A",
                    "B",
                    "C",
                    "D",
                    "E"
                  ]
                }
              }
            }
          }
        }
      }
    },

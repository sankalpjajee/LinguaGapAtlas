{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/sankalpjajee/LinguaGapAtlas/release/linguagapatlas.schema.json",
  "title": "LinguaGapAtlas release document",
  "description": "Schema for linguagapatlas.json (the whole document) and, via #/$defs/resource, for each line of linguagapatlas.jsonl.",
  "type": "object",
  "required": [
    "name",
    "title",
    "version",
    "description",
    "keywords",
    "authors",
    "citation",
    "paper",
    "repository",
    "license",
    "null_rule",
    "sources",
    "generator",
    "fields",
    "taxonomy",
    "coding",
    "statistics",
    "caveats",
    "screening_log",
    "resources"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "resources": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/resource"
      }
    },
    "name": {},
    "title": {},
    "version": {},
    "description": {},
    "keywords": {},
    "authors": {},
    "citation": {},
    "paper": {},
    "repository": {},
    "license": {},
    "null_rule": {},
    "sources": {},
    "generator": {},
    "fields": {},
    "taxonomy": {},
    "coding": {},
    "statistics": {},
    "caveats": {},
    "screening_log": {}
  },
  "$defs": {
    "resource_id": {
      "type": "string",
      "pattern": "^QG-\\d{3}$"
    },
    "resource": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "resource_id",
        "resource_name",
        "canonical_reference",
        "type",
        "year",
        "languages",
        "language_names",
        "languages_fully_named",
        "language_count",
        "data_origin",
        "resource_tier",
        "task_class",
        "cultural_specificity",
        "inference_paradigm",
        "provenance_url",
        "evidence_note",
        "coder",
        "confidence",
        "screening_status",
        "screening_reason",
        "consensus",
        "rounds"
      ],
      "properties": {
        "resource_id": {
          "$ref": "#/$defs/resource_id",
          "description": "Stable ID assigned by this project, form QG-001…QG-096. Never reused, never renumbered between versions."
        },
        "resource_name": {
          "type": "string",
          "description": "The resource's canonical name as given by its creators (e.g. the benchmark/dataset name used in its paper)."
        },
        "canonical_reference": {
          "type": [
            "string",
            "null"
          ],
          "description": "Full citation (authors, title, venue, year) of the paper or release that introduces the resource. null if the resource has no citable paper."
        },
        "type": {
          "enum": [
            "Benchmark",
            "Dataset"
          ],
          "description": "Benchmark or Dataset. Benchmarks are resources designed for evaluation; datasets are resources designed primarily for training. A resource released as both is coded by its primary stated purpose and the dual nature is noted in evidence_note."
        },
        "year": {
          "type": [
            "integer",
            "null"
          ],
          "description": "Year of first public release (paper or public artifact, whichever came first). null if not determinable."
        },
        "languages": {
          "type": [
            "string",
            "null"
          ],
          "description": "Semicolon-separated list of language names (or ISO 639 codes) the resource covers, as documented by its creators. null if the documentation does not enumerate them."
        },
        "language_names": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": "string"
          },
          "description": "Derived from `languages`: the entries that name a language, in source order (entries such as '75 languages' that only state a count are left out). null when `languages` is null."
        },
        "languages_fully_named": {
          "type": "boolean",
          "description": "true when `language_names` names every covered language: no count-only entries and as many names as `language_count`."
        },
        "language_count": {
          "type": [
            "integer",
            "null"
          ],
          "description": "Number of languages covered, counted from languages where enumerated, otherwise the count stated by the creators. null if neither is available. Never estimated."
        },
        "data_origin": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            "Native",
            "Translated",
            "Mixed",
            null
          ],
          "description": "How the resource's content was produced. Native: authored originally in the target language(s). Translated: produced by translating content from another language (human or machine). Mixed: both routes used for substantial portions. null if the production route is not documented."
        },
        "resource_tier": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            "Low",
            "Medium",
            "High",
            null
          ],
          "description": "Linguistic resource tier of the language(s) the resource targets, per the paper's tiering of language resourcedness. For multilingual resources, the tier of the lowest-resourced language substantially covered. null if the covered languages cannot be established."
        },
        "task_class": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            "Pre-training",
            "Translation",
            "Instruction",
            "QA",
            "NLU",
            "Generation",
            "Other",
            "Syntax",
            "Reasoning",
            "Multimodal",
            "Summarization",
            "Math",
            "RAG",
            "Code",
            "Long Context",
            "Embeddings",
            null
          ],
          "description": "The task family the resource evaluates or supports. Benchmarks: QA, Syntax, Reasoning, Multimodal, NLU, Summarization, Math, RAG, Code, Other. Datasets: Pre-training, Translation, Instruction. A resource spanning several classes is coded by its primary class; secondary classes go in evidence_note."
        },
        "cultural_specificity": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            "Universal",
            "Region-Specific",
            "Culturally Anchored",
            null
          ],
          "description": "Universal: designed to be culturally non-specific. Culturally Anchored: content is grounded in the cultural context of its language community without being tied to one sub-region. Region-Specific: content is grounded in a particular country/region's context. null if the documentation does not support a judgement."
        },
        "inference_paradigm": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            "Discriminative",
            "Generative",
            "Retrieval-Augmented",
            "Mixed",
            "Other",
            "confidence",
            null
          ],
          "description": "The inference/evaluation paradigm the resource is built around. Vocabulary to be confirmed against the final codebook before v1.0.0; rows coded before confirmation carry the coder's best judgement and are flagged in confidence. null if not determinable."
        },
        "provenance_url": {
          "type": [
            "string",
            "null"
          ],
          "description": "The evidence source the row's labels were taken from — the resource's paper, repository, or documentation page actually consulted. Every coded dimension in the row must be supported by this source or by evidence_note. null only for rows with no coded dimensions."
        },
        "evidence_note": {
          "type": [
            "string",
            "null"
          ],
          "description": "Free-text note recording what the source states that supports the labels (quoted or paraphrased), plus any dual-nature or secondary-class remarks. This is the audit trail for the row."
        },
        "coder": {
          "type": [
            "string",
            "null"
          ],
          "description": "Identifier of the coder who produced this row's labels (initials or coder ID used in the reliability study)."
        },
        "confidence": {
          "enum": [
            "high",
            "medium",
            "low"
          ],
          "description": "Coder's confidence in the row's labels: high, medium, or low. low rows are candidates for adjudication and are reported as such. null if not recorded."
        },
        "screening_status": {
          "const": "included",
          "description": "Disposition of this resource in the screening pipeline (see data/screening-log.csv): for rows in corpus.csv this is always included; the full candidate set, including exclusions, lives in the screening log."
        },
        "screening_reason": {
          "type": [
            "string",
            "null"
          ],
          "description": "For included rows, the eligibility basis (e.g. which inclusion criterion the resource met). Exclusion reasons are recorded in the screening log, not here."
        },
        "consensus": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "data_origin",
            "resource_tier",
            "task_class",
            "cultural_specificity",
            "inference_paradigm"
          ],
          "properties": {
            "type": {
              "$ref": "#/$defs/decision_type"
            },
            "data_origin": {
              "$ref": "#/$defs/decision_data_origin"
            },
            "resource_tier": {
              "$ref": "#/$defs/decision_resource_tier"
            },
            "task_class": {
              "$ref": "#/$defs/decision_task_class"
            },
            "cultural_specificity": {
              "$ref": "#/$defs/decision_cultural_specificity"
            },
            "inference_paradigm": {
              "$ref": "#/$defs/decision_inference_paradigm"
            }
          },
          "description": "Per label field, how the five rounds voted: the consensus value, its status (consensus | no_majority | not_coded), the supporting vote count, the number of rounds that coded the cell, whether the rounds split, and every vote with the rounds that cast it."
        },
        "rounds": {
          "type": "array",
          "minItems": 5,
          "maxItems": 5,
          "items": {
            "$ref": "#/$defs/round"
          },
          "description": "The five independent coding rounds' own records for this resource (A-E), with labels in canonical form and as written."
        }
      }
    },
    "round": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "round",
        "resource_id",
        "canonical_reference",

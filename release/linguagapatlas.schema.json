{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/sankalpjajee/LinguaGapAtlas/release/linguagapatlas.schema.json",
  "title": "LinguaGapAtlas release document",
  "description": "Schema for linguagapatlas.json (the whole document) and, via #/$defs/resource, for each line of linguagapatlas.jsonl. Invariants it cannot express (e.g. vote counts summing to rounds_coded, the consensus value matching the top-level label) are enforced by scripts/build_release.py.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "name",
    "title",
    "version",
    "date_released",
    "doi",
    "description",
    "keywords",
    "authors",
    "citation",
    "paper",
    "repository",
    "license",
    "null_rule",
    "sources",
    "generator",
    "fields",
    "taxonomy",
    "coding",
    "statistics",
    "caveats",
    "screening_log",
    "resources"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "date_released": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "doi": {
      "type": [
        "string",
        "null"
      ]
    },
    "description": {
      "type": "string",
      "minLength": 1
    },
    "keywords": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "authors": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "given_names",
          "family_names",
          "orcid"
        ],
        "properties": {
          "given_names": {
            "type": "string",
            "minLength": 1
          },
          "family_names": {
            "type": "string",
            "minLength": 1
          },
          "orcid": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    },
    "citation": {
      "type": "string",
      "minLength": 1
    },
    "paper": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "title",
        "status"
      ],
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "repository": {
      "type": "string",
      "minLength": 1
    },
    "license": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "data",
        "data_url",
        "code",
        "code_url",
        "note"
      ],
      "properties": {
        "data": {
          "type": "string",
          "minLength": 1
        },
        "data_url": {
          "type": "string",
          "minLength": 1
        },
        "code": {
          "type": "string",
          "minLength": 1
        },
        "code_url": {
          "type": "string",
          "minLength": 1
        },
        "note": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "null_rule": {
      "type": "string",
      "minLength": 1
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "sha256"
        ],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        }
      }
    },
    "generator": {
      "type": "string",
      "minLength": 1
    },
    "fields": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "field",
          "type",
          "description",
          "source"
        ],
        "properties": {
          "field": {
            "type": "string",
            "minLength": 1
          },
          "type": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string",
            "minLength": 1
          },
          "source": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "taxonomy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "dimensions",
        "confidence"
      ],
      "properties": {
        "type": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "value",
              "applies_to",
              "listed_in_data_dictionary"
            ],
            "properties": {
              "value": {
                "type": "string",
                "minLength": 1
              },
              "applies_to": {
                "type": [
                  "array",
                  "null"
                ],
                "items": {
                  "enum": [
                    "Benchmark",
                    "Dataset"
                  ]
                }
              },
              "listed_in_data_dictionary": {
                "type": "boolean"
              }
            }
          }
        },
        "dimensions": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "field",
              "name",
              "definition",
              "values"
            ],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^D[1-5]$"
              },
              "field": {
                "type": "string",
                "minLength": 1
              },
              "name": {
                "type": "string",
                "minLength": 1
              },
              "definition": {
                "type": "string",
                "minLength": 1
              },
              "values": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "value",
                    "applies_to",
                    "listed_in_data_dictionary"
                  ],
                  "properties": {
                    "value": {
                      "type": "string",
                      "minLength": 1
                    },
                    "applies_to": {
                      "type": [
                        "array",
                        "null"
                      ],
                      "items": {
                        "enum": [
                          "Benchmark",
                          "Dataset"
                        ]
                      }
                    },
                    "listed_in_data_dictionary": {
                      "type": "boolean"
                    }
                  }
                }
              }
            }
          }
        },
        "confidence": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "coding": {
      "type": "object",
      "required": [
        "design",
        "rounds",
        "label_normalization",
        "consensus_rules",
        "source_columns",
        "reconstruction",
        "generator"
      ]
    },
    "statistics": {
      "type": "object",
      "required": [
        "note",
        "composition",
        "headline_shares",
        "headline_shares_by_round",
        "distributions",
        "consensus_coverage",
        "agreement"
      ]
    },
    "caveats": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "topic",
          "text"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "topic": {
            "type": "string",
            "minLength": 1
          },
          "text": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "screening_log": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source",
        "columns",
        "candidate_count",
        "candidates"
      ],
      "properties": {
        "source": {
          "type": "string",
          "minLength": 1
        },
        "columns": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "candidate_count": {
          "type": "integer",
          "minimum": 0
        },
        "candidates": {
          "type": "array",
          "items": {
            "type": "object"
          }
        }
      }
    },
    "resources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/resource"
      }
    }
  },
  "$defs": {
    "resource_id": {
      "type": "string",
      "pattern": "^QG-[0-9]{3}$"
    },
    "resource": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "resource_id",
        "resource_name",
        "canonical_reference",
        "type",
        "year",
        "languages",
        "language_names",
        "languages_fully_named",
        "language_count",
        "data_origin",
        "resource_tier",
        "task_class",
        "cultural_specificity",
        "inference_paradigm",
        "provenance_url",
        "evidence_note",
        "coder",
        "confidence",
        "screening_status",
        "screening_reason",
        "consensus",
        "rounds"
      ],
      "properties": {
        "resource_id": {
          "$ref": "#/$defs/resource_id",
          "description": "Stable ID assigned by this project, form QG-001…QG-096. Never reused, never renumbered between versions."
        },
        "resource_name": {
          "type": "string",
          "minLength": 1,
          "description": "The resource's canonical name as given by its creators (e.g. the benchmark/dataset name used in its paper)."
        },
        "canonical_reference": {
          "type": [
            "string",
            "null"
          ],
          "description": "Full citation (authors, title, venue, year) of the paper or release that introduces the resource. null if the resource has no citable paper."
        },
        "type": {
          "type": "string",
          "enum": [
            "Benchmark",
            "Dataset"
          ],
          "description": "Benchmark or Dataset. Benchmarks are resources designed for evaluation; datasets are resources designed primarily for training. A resource released as both is coded by its primary stated purpose and the dual nature is noted in evidence_note."
        },
        "year": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1900,
          "maximum": 2100,
          "description": "Year of first public release (paper or public artifact, whichever came first). null if not determinable."
        },
        "languages": {
          "type": [
            "string",
            "null"
          ],
          "description": "Semicolon-separated list of language names (or ISO 639 codes) the resource covers, as documented by its creators. null if the documentation does not enumerate them."
        },
        "language_names": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": "string",
            "minLength": 1
          },
          "description": "Derived from `languages`: the entries that name a language, in source order (entries such as '75 languages' that only state a count are left out). null when `languages` is null."
        },
        "languages_fully_named": {
          "type": "boolean",
          "description": "true when `language_names` names every covered language: no count-only entries and as many names as `language_count`."
        },
        "language_count": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1,
          "description": "Number of languages covered, counted from languages where enumerated, otherwise the count stated by the creators. null if neither is available. Never estimated."
        },
        "data_origin": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            "Native",
            "Translated",
            "Mixed",
            null
          ],
          "description": "How the resource's content was produced. Native: authored originally in the target language(s). Translated: produced by translating content from another language (human or machine). Mixed: both routes used for substantial portions. null if the production route is not documented."
        },
        "resource_tier": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            "Low",
            "Medium",
            "High",
            null
          ],
          "description": "Linguistic resource tier of the language(s) the resource targets, per the paper's tiering of language resourcedness. For multilingual resources, the tier of the lowest-resourced language substantially covered. null if the covered languages cannot be established."
        },
        "task_class": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            "Pre-training",
            "Translation",
            "Instruction",
            "QA",
            "NLU",
            "Generation",
            "Other",
            "Syntax",
            "Reasoning",
            "Multimodal",
            "Summarization",
            "Math",
            "RAG",
            "Code",
            "Long Context",
            "Embeddings",
            null
          ],
          "description": "The task family the resource evaluates or supports. Benchmarks: QA, Syntax, Reasoning, Multimodal, NLU, Summarization, Math, RAG, Code, Other. Datasets: Pre-training, Translation, Instruction. A resource spanning several classes is coded by its primary class; secondary classes go in evidence_note."
        },
        "cultural_specificity": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            "Universal",
            "Region-Specific",
            "Culturally Anchored",
            null
          ],
          "description": "Universal: designed to be culturally non-specific. Culturally Anchored: content is grounded in the cultural context of its language community without being tied to one sub-region. Region-Specific: content is grounded in a particular country/region's context. null if the documentation does not support a judgement."
        },
        "inference_paradigm": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            "Discriminative",
            "Generative",
            "Retrieval-Augmented",
            "Mixed",
            "Other",
            null
          ],
          "description": "The inference/evaluation paradigm the resource is built around. Vocabulary to be confirmed against the final codebook before v1.0.0; rows coded before confirmation carry the coder's best judgement and are flagged in confidence. null if not determinable."
        },
        "provenance_url": {
          "type": [
            "string",
            "null"
          ],
          "description": "The evidence source the row's labels were taken from — the resource's paper, repository, or documentation page actually consulted. Every coded dimension in the row must be supported by this source or by evidence_note. null only for rows with no coded dimensions."
        },
        "evidence_note": {
          "type": [
            "string",
            "null"
          ],
          "description": "Free-text note recording what the source states that supports the labels (quoted or paraphrased), plus any dual-nature or secondary-class remarks. This is the audit trail for the row."
        },
        "coder": {
          "const": "consensus-5rounds",
          "description": "Always 'consensus-5rounds': the row is the majority vote of the five coding rounds. Each round's coder is its round letter (see rounds)."
        },
        "confidence": {
          "enum": [
            "high",
            "medium",
            "low"
          ],
          "description": "Derived from the vote, not recorded by a coder: high when none of the voted label cells is split or without majority, medium for 1-2 such cells, low for 3 or more. Each round's own confidence is under rounds."
        },
        "screening_status": {
          "const": "included",
          "description": "Disposition of this resource in the screening pipeline (see data/screening-log.csv): for rows in corpus.csv this is always included; the full candidate set, including exclusions, lives in the screening log."
        },
        "screening_reason": {
          "type": [
            "string",
            "null"
          ],
          "description": "For included rows, the eligibility basis (e.g. which inclusion criterion the resource met). Exclusion reasons are recorded in the screening log, not here."
        },
        "consensus": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "data_origin",
            "resource_tier",
            "task_class",
            "cultural_specificity",
            "inference_paradigm"
          ],
          "properties": {
            "type": {
              "$ref": "#/$defs/decision_type"
            },
            "data_origin": {
              "$ref": "#/$defs/decision_data_origin"
            },
            "resource_tier": {
              "$ref": "#/$defs/decision_resource_tier"
            },
            "task_class": {
              "$ref": "#/$defs/decision_task_class"
            },
            "cultural_specificity": {
              "$ref": "#/$defs/decision_cultural_specificity"
            },
            "inference_paradigm": {
              "$ref": "#/$defs/decision_inference_paradigm"
            }
          },
          "description": "Per label field, how the five rounds voted: the consensus value, its status (consensus | no_majority | not_coded), the supporting vote count, the number of rounds that coded the cell, whether the rounds split, and every vote with the rounds that cast it."
        },
        "rounds": {
          "type": "array",
          "minItems": 5,
          "prefixItems": [
            {
              "$ref": "#/$defs/round",
              "properties": {
                "round": {
                  "const": "A"
                }
              }
            },
            {
              "$ref": "#/$defs/round",
              "properties": {
                "round": {
                  "const": "B"
                }
              }
            },
            {
              "$ref": "#/$defs/round",
              "properties": {
                "round": {
                  "const": "C"
                }
              }
            },
            {
              "$ref": "#/$defs/round",
              "properties": {
                "round": {
                  "const": "D"
                }
              }
            },
            {
              "$ref": "#/$defs/round",
              "properties": {
                "round": {
                  "const": "E"
                }
              }
            }
          ],
          "items": false,
          "description": "The five independent coding rounds' own records for this resource (A-E), with labels in canonical form and as written."
        }
      }
    },
    "round": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "round",
        "resource_id",
        "canonical_reference",
        "type",
        "year",
        "languages",
        "language_count",
        "data_origin",
        "resource_tier",
        "task_class",
        "cultural_specificity",
        "inference_paradigm",
        "provenance_url",
        "evidence_note",
        "confidence",
        "screening_reason",
        "labels_as_written"
      ],
      "properties": {
        "round": {
          "enum": [
            "A",
            "B",
            "C",
            "D",
            "E"
          ]
        },
        "resource_id": {
          "$ref": "#/$defs/resource_id"
        },
        "canonical_reference": {
          "type": [
            "string",
            "null"
          ]
        },
        "type": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            "Benchmark",
            "Dataset",
            null
          ]
        },
        "year": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1900,
          "maximum": 2100
        },
        "languages": {
          "type": [
            "string",
            "null"
          ]
        },
        "language_count": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        },
        "data_origin": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            "Native",
            "Translated",
            "Mixed",
            null
          ]
        },
        "resource_tier": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            "Low",
            "Medium",
            "High",
            null
          ]
        },
        "task_class": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            "Pre-training",
            "Translation",
            "Instruction",
            "QA",
            "NLU",
            "Generation",
            "Other",
            "Syntax",
            "Reasoning",
            "Multimodal",
            "Summarization",
            "Math",
            "RAG",
            "Code",
            "Long Context",
            "Embeddings",
            null
          ]
        },
        "cultural_specificity": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            "Universal",
            "Region-Specific",
            "Culturally Anchored",
            null
          ]
        },
        "inference_paradigm": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            "Discriminative",
            "Generative",
            "Retrieval-Augmented",
            "Mixed",
            "Other",
            null
          ]
        },
        "provenance_url": {
          "type": [
            "string",
            "null"
          ]
        },
        "evidence_note": {
          "type": [
            "string",
            "null"
          ]
        },
        "confidence": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            "high",
            "medium",
            "low",
            null
          ]
        },
        "screening_reason": {
          "type": [
            "string",
            "null"
          ]
        },
        "labels_as_written": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "data_origin",
            "resource_tier",
            "task_class",
            "cultural_specificity",
            "inference_paradigm"
          ],
          "properties": {
            "type": {
              "type": [
                "string",
                "null"
              ]
            },
            "data_origin": {
              "type": [
                "string",
                "null"
              ]
            },
            "resource_tier": {
              "type": [
                "string",
                "null"
              ]
            },
            "task_class": {
              "type": [
                "string",
                "null"
              ]
            },
            "cultural_specificity": {
              "type": [
                "string",
                "null"
              ]
            },
            "inference_paradigm": {
              "type": [
                "string",
                "null"
              ]
            }
          },
          "description": "The round's label strings exactly as written in its file."
        }
      }
    },
    "decision_type": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "value",
        "status",
        "support",
        "rounds_coded",
        "split",
        "votes"
      ],
      "properties": {
        "value": {
          "enum": [
            "Benchmark",
            "Dataset",
            null
          ]
        },
        "status": {
          "enum": [
            "consensus",
            "no_majority",
            "not_coded"
          ]
        },
        "support": {
          "type": "integer",
          "minimum": 0,
          "maximum": 5
        },
        "rounds_coded": {
          "type": "integer",
          "minimum": 0,
          "maximum": 5
        },
        "split": {
          "type": "boolean"
        },
        "votes": {
          "type": "array",
          "maxItems": 5,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "value",
              "count",
              "rounds"
            ],
            "properties": {
              "value": {
                "enum": [
                  "Benchmark",
                  "Dataset"
                ]
              },
              "count": {
                "type": "integer",
                "minimum": 1,
                "maximum": 5
              },
              "rounds": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": {
                  "enum": [
                    "A",
                    "B",
                    "C",
                    "D",
                    "E"
                  ]
                }
              }
            }
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "consensus"
              }
            }
          },
          "then": {
            "properties": {
              "value": {
